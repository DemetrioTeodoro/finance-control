generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  password String

  hideSensitiveValues Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  creditCards    CreditCard[]
  categories     Category[]
  transactions   Transaction[]
  recurringBills RecurringBill[]
}

model Account {
  id      String  @id @default(cuid())
  name    String
  type    String
  balance Decimal @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditCard {
  id         String   @id @default(cuid())
  name       String
  limit      Decimal?
  closingDay Int
  dueDay     Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions    Transaction[]
  invoicePayments Transaction[] @relation("CreditCardInvoicePayment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id    String  @id @default(cuid())
  name  String
  icon  String?
  color String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions   Transaction[]
  recurringBills RecurringBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Transaction {
  id String @id @default(cuid())

  description String
  amount      Decimal
  type        String
  date        DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  paidCreditCardId String?
  paidCreditCard   CreditCard? @relation("CreditCardInvoicePayment", fields: [paidCreditCardId], references: [id], onDelete: SetNull)

  paidRecurringBillId String?
  paidRecurringBill   RecurringBill? @relation("RecurringBillPaymentTransaction", fields: [paidRecurringBillId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// ID da transação no arquivo de origem (FITID do OFX), usado para não
  /// importar a mesma transação duas vezes quando o extrato/fatura é
  /// importado mais de uma vez com períodos sobrepostos. Nulo para
  /// transações criadas manualmente ou vindas de OFX sem FITID.
  externalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, externalId])
  @@unique([creditCardId, externalId])
}

model RecurringBill {
  id             String   @id @default(cuid())
  name           String
  expectedAmount Decimal?
  dueDay         Int
  active         Boolean  @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  payments           RecurringBillPayment[]
  paidByTransactions Transaction[]          @relation("RecurringBillPaymentTransaction")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Confirmação manual de pagamento SEM transação vinculada (ex.: pago em
/// dinheiro, fora do fluxo rastreado). Quando há uma transação, o vínculo é
/// feito direto em `Transaction.paidRecurringBillId` — não duplicado aqui.
model RecurringBillPayment {
  id    String @id @default(cuid())
  year  Int
  month Int // 0-indexado, igual ao Date nativo (mesma convenção de InvoiceCycleKey)

  recurringBillId String
  recurringBill   RecurringBill @relation(fields: [recurringBillId], references: [id], onDelete: Cascade)

  confirmedAt DateTime @default(now())

  @@unique([recurringBillId, year, month])
}
