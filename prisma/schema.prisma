generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  password String

  hideSensitiveValues Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  creditCards    CreditCard[]
  categories     Category[]
  transactions   Transaction[]
  recurringBills RecurringBill[]
}

model Account {
  id      String  @id @default(cuid())
  name    String
  type    String
  balance Decimal @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditCard {
  id         String   @id @default(cuid())
  name       String
  limit      Decimal?
  closingDay Int
  dueDay     Int

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions    Transaction[]
  invoicePayments Transaction[] @relation("CreditCardInvoicePayment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id    String  @id @default(cuid())
  name  String
  icon  String?
  color String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions   Transaction[]
  recurringBills RecurringBill[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
}

model Transaction {
  id String @id @default(cuid())

  description String
  amount      Decimal
  type        String
  date        DateTime

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: SetNull)

  paidCreditCardId String?
  paidCreditCard   CreditCard? @relation("CreditCardInvoicePayment", fields: [paidCreditCardId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  recurringBillPayments RecurringBillPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecurringBill {
  id             String   @id @default(cuid())
  name           String
  expectedAmount Decimal?
  dueDay         Int
  active         Boolean  @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  payments RecurringBillPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RecurringBillPayment {
  id    String @id @default(cuid())
  year  Int
  month Int // 0-indexado, igual ao Date nativo (mesma convenção de InvoiceCycleKey)

  recurringBillId String
  recurringBill   RecurringBill @relation(fields: [recurringBillId], references: [id], onDelete: Cascade)

  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  confirmedAt DateTime @default(now())

  @@unique([recurringBillId, year, month])
}
